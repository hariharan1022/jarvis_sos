# SafeNova AI - Backend Environment Template
# Copy this file to .env and fill in real values before running.

# ─────────────────────────────────────────────
# 🔐 Security
# ─────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_use_a_strong_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─────────────────────────────────────────────
# 🗄️ Database
# ─────────────────────────────────────────────
# SQLite (development):
DATABASE_URL=sqlite:///./safenova.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/safenova

# ─────────────────────────────────────────────
# 📁 File Uploads
# ─────────────────────────────────────────────
UPLOAD_DIR=uploads

# ─────────────────────────────────────────────
# 📧 Email Alert Configuration
# ─────────────────────────────────────────────
# Choose provider: smtp | resend | sendgrid
EMAIL_PROVIDER=smtp

# --- SMTP Settings ---
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# Ethereal (sandbox testing): SMTP_HOST=smtp.ethereal.email, SMTP_PORT=587
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-smtp-user@ethereal.email
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=SafeNova Alerts <your-smtp-user@ethereal.email>

# --- Resend (production) ---
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# --- SendGrid (production) ---
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────
# 📱 Twilio SMS / WhatsApp / Call
# ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=+1XXXXXXXXXX
DEFAULT_COUNTRY_CODE=+1

# ─────────────────────────────────────────────
# 🌐 CORS Origins (comma-separated)
# ─────────────────────────────────────────────
# ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.com
